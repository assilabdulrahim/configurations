{
  "$schema": "https://opencode.ai/config.json",

  // ── Cost posture ─────────────────────────────────────────────
  // Four cost classes:
  //
  //   L0 LOCAL         Ollama box on the LAN. Free, unlimited, PRIVATE.
  //                    Weak on capability: 32k-256k context.
  //   L1 FREE          OpenCode Zen free models (big-pickle, nemotron,
  //                    muse, ling) - the whole tier sits on the opencode
  //                    provider. Free, 200k-1M context, tool-capable.
  //   L2 SUBSCRIPTION  Kimi. Flat cost but FINITE QUOTA. The default tier.
  //   L3 METERED       DeepSeek, Google, OpenRouter, Anthropic. Per-token.
  //                    Analysis + validation, the provider-outage escape hatch,
  //                    and two reserved Anthropic agents (see below).
  //
  // The router (agents/orchestrator.md) runs on K3 whenever the Kimi quota is
  // live and on DeepSeek Flash when it is not - scripts/router-model.cjs
  // switches the deployed pin before a session starts (opencode cannot fail a
  // primary agent over mid-session).
  //
  // The rule the router follows (agents/orchestrator.md §2):
  //
  //   Quality first. Default to L2 (Kimi). Use L3 for analysis and
  //   validation. Drop to L1 when L2/L3 quota or credit runs out.
  //   Use L0 for privacy, compression and trivia.
  //   Never validate a model's work with the same model.
  //
  // L0 keeps the jobs nothing else should take: work that must not leave
  // the LAN, session compression, and housekeeping - logging, records and
  // mechanical audits - run in parallel with the paid hops (orchestrator §14).
  // The full escalation ladder is in agents/orchestrator.md.

  // Default when no agent is selected. A free OpenCode Zen model - 200k
  // context, tool-capable, costs nothing, and the opencode provider is
  // already authenticated (see scripts/preflight.cjs).
  "model": "opencode/big-pickle",

  // Title generation / bookkeeping only. Kept local so it never touches quota.
  "small_model": "ollama/qwen2.5-coder:7b",

  // Every request goes through the router.
  // Previously disabled while chasing a hang. Cause identified: subagents
  // were pinned to a model that is not installed (qwen3-coder-next) and to
  // one with no tool-calling capability (deepseek-coder-v2). Both fixed.
  "default_agent": "orchestrator",

  // ── Providers ────────────────────────────────────────────────
  // opencode (Zen), deepseek, moonshotai and anthropic are first-class in
  // models.dev - they need `opencode auth login`, not a provider block.
  // kimi-for-coding and the local box are described below.
  //
  // anthropic reaches two agents: `prompt-smith` (claude-sonnet-5), which
  // writes the §10 briefs and the agents/ and skills/ prompt files, and
  // `opus-coder` (claude-opus-5), the escalation implementer. Both are metered
  // per token and spent in moderation, so both are gated: agents/orchestrator.md
  // §7 names the conditions under which the router may reach each (opus-coder
  // also carries a two-hops-per-session budget), and §5 keeps both out of every
  // fallback chain so nothing failing can spend on them by accident.
  // Reachable directly with /prompt and /opus. Until the anthropic credential exists -
  // added in the app's provider settings, or supplied as ANTHROPIC_API_KEY in
  // the environment, or via `opencode auth login` if you use the CLI - that one
  // agent is DEAD and nothing else is affected. preflight.cjs reports which of
  // those sources is actually in play.
  "provider": {
    // Pinned here, not left to models.dev. On 2026-09-18 models.dev renamed this
    // provider to `kimi-code-plan-global`, so `kimi-for-coding/*` stopped
    // resolving - and opencode does not fail an unresolvable subagent pin, it
    // silently runs the subagent on the CALLER's model (deepseek-flash). That is
    // how 862 "moonshot-coder" messages ran on DeepSeek and were then "validated"
    // by DeepSeek. The id stays `kimi-for-coding` so the existing auth.json
    // credential and every agent pin keep working.
    "kimi-for-coding": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi Code (subscription)",
      "options": { "baseURL": "https://api.kimi.com/coding/v1" },
      "models": {
        "k3": { "name": "Kimi K3 (1M)", "tool_call": true, "attachment": true, "limit": { "context": 1048576, "output": 131072 } },
        "k3-256k": { "name": "Kimi K3 (256k)", "tool_call": true, "attachment": true, "limit": { "context": 262144, "output": 131072 } },
        "kimi-for-coding": { "name": "Kimi for Coding", "tool_call": true, "attachment": true, "limit": { "context": 1048576, "output": 32768 } },
        "kimi-for-coding-highspeed": { "name": "Kimi for Coding Highspeed", "tool_call": true, "attachment": true, "limit": { "context": 262144, "output": 32768 } }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Linux AI Server",
      "options": {
        "baseURL": "http://192.168.86.24:11434/v1",
        "apiKey": "ollama"
      },
      // Verified against http://192.168.86.24:11434/api/tags.
      // Never list a model that is not actually pulled - it surfaces as a
      // hang, not as a clean error.
      "models": {
        "llama3.1:70b": { "name": "Llama 3.1 70B (Local, 131k, tools)" },
        "qwen3:32b": { "name": "Qwen3 32B (Local, 40k, tools+thinking)" },
        "gemma4:26b": { "name": "Gemma 4 26B (Local, 256k, tools+thinking)" },
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B (Local, 32k, NO parsed tool calls)" }
        // Measured by scripts/smoke-agents.cjs: this model answers, but
        // its tool call comes back as JSON *inside content* - ollama does
        // not parse it into `tool_calls`, so no harness can execute it.
        // Fine as small_model (titles); do not route edits here.
        // Deliberately absent:
        //   deepseek-coder-v2  - capabilities ["completion","insert"], no
        //                        tool calling, so it cannot drive an agent.
        //   qwen3-embedding:8b - embedding only.
        //   qwen3-coder-next   - referenced by the old config, never pulled.
      }
    }
  },

  // ── Context maintenance ──────────────────────────────────────
  "compaction": {
    "auto": true,
    "prune": true,        // drop stale tool output before dropping reasoning
    "tail_turns": 8
  },

  // Depth 1: subagents cannot spawn subagents. Deliberate - every hop back
  // through the router preserves context in one place. Letting specialists
  // re-delegate fragments the session across contexts nothing reconciles.
  "subagent_depth": 1,

  // ── Convenience commands ─────────────────────────────────────
  "command": {
    "preflight": {
      "description": "Which providers are authed, what credit is left, which agents are usable",
      "template": "Run: node scripts/preflight.cjs — then summarise which agents are usable, which are DEAD and why, and any provider that is low on credit."
    },
    "ctx": {
      "description": "Measure how many tokens a path set is, and which tiers hold it",
      "template": "Run: node scripts/ctx-estimate.cjs $ARGUMENTS — then state the smallest tier reporting FITS and route accordingly."
    },
    "doc": {
      "description": "Write a technical document - design doc, ADR, runbook, README, spec",
      "agent": "doc-writer",
      "template": "Invoke the `document` skill. $ARGUMENTS"
    },
    "threat-model": {
      "description": "STRIDE threat model / security review of this repo or a design",
      "agent": "security-reviewer",
      "template": "Invoke the `security-review` skill. $ARGUMENTS"
    },
    "design": {
      "description": "Software architecture - boundaries, trade-offs, C4, ADR",
      "agent": "architect",
      "template": "Invoke the `architecture` skill. $ARGUMENTS"
    },
    "cloud": {
      "description": "Cloud architecture - topology, networking, resilience, cost, IaC",
      "agent": "cloud-architect",
      "template": "Invoke the `cloud-architecture` skill. $ARGUMENTS"
    },
    "free": {
      "description": "Force this task onto the free OpenCode Zen tier",
      "agent": "free-coder",
      "template": "$ARGUMENTS"
    },
    "validate": {
      "description": "Cross-model validation of the current diff (never the model that wrote it)",
      // Routed through the orchestrator, NOT straight to `validator`. A command
      // pinned to one agent bypasses §5 entirely, so a single 429 on Google's
      // per-model daily cap used to surface raw to the user with no backup tried.
      "agent": "orchestrator",
      "template": "Validate the uncommitted changes in this repo. Read .opencode/handoff.md first to see which model produced them, pick a validator from a different family (§8), and on any 402/429/5xx walk that validator's backups (§5 Backups per agent) - announce each switch. Report as path:line - problem - suggested fix, then a one-line verdict: PASS or CHANGES-REQUESTED, naming the validator that actually ran."
    },
    "local": {
      "description": "Force this task onto the local Ollama box - nothing leaves the LAN",
      "agent": "local-coder",
      "template": "$ARGUMENTS"
    },
    "prompt": {
      "description": "Write the brief for a hop, or author/audit an agent or skill prompt",
      "agent": "prompt-smith",
      "template": "$ARGUMENTS"
    },
    "opus": {
      "description": "Send this task to Claude Opus 5 - the strongest implementer, metered (Anthropic credit)",
      "agent": "opus-coder",
      "template": "$ARGUMENTS"
    },
    "router": {
      // On local-reasoner (ollama) on purpose: this is the command you reach for
      // when the router's own provider is down, so it must not depend on it -
      // or on any cloud provider.
      "description": "Re-pin the router: K3 if the Kimi quota is live, DeepSeek Flash if not",
      "agent": "local-reasoner",
      "template": "Run exactly: node C:/Users/AssilAbdulrahim/.config/opencode/scripts/router-model.cjs auto $ARGUMENTS - then report its output verbatim and tell the user the new pin applies to the next session."
    }
  },

  // ── Permissions ──────────────────────────────────────────────
  // Allow by default; deny only what is destructive or outbound. There is
  // deliberately NO "ask" anywhere in this config or in agents/*.md.
  //
  // Why: an "ask" raised inside a SUBAGENT blocks that subagent's session, and
  // the prompt is not shown in the orchestrator session you are watching. The
  // traces for 2026-09-13..19 show 37 shell calls parked on such prompts for
  // 82.6 hours in total (single calls of 8-11h, e.g. `mkdir`, `Get-Location`),
  // against 11.3h of model time and 4.3h of real command execution. The old
  // allow-list also only knew bash verbs (ls, cat, grep) while the shell here
  // is PowerShell, so nearly every Get-ChildItem / Test-Path / & dotnet fell
  // through to "ask". A deny returns an error the model can act on; an ask
  // hangs. So: allow, or deny - never ask.
  //
  // Precedence: the LAST matching rule wins, so "*" comes first and every deny
  // after it. opencode parses PowerShell imperfectly (it split here-strings
  // into lines and asked about prose), so this deny list is a best-effort net,
  // not a sandbox. Agent files carry no bash block - they inherit this one.
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    // Paths outside the project. Models hallucinate paths (source\recv\repos,
    // BrainRegistration365) and quote remote ssh paths (~/kbqs-it); each used to
    // raise a prompt for a folder that does not exist. Allow, except secrets.
    "external_directory": {
      "*": "allow",
      "C:/Users/*/.ssh/*": "deny",
      "C:/Users/*/.local/share/opencode/auth.json": "deny"
    },
    "bash": {
      "*": "allow",

      // bash / POSIX
      "sudo *": "deny",
      // Every deny the previous config had is kept: all of rm, rmdir, and
      // find -delete / -exec (find -exec can run rm by another name).
      "rm *": "deny",
      "rmdir *": "deny",
      "find * -delete*": "deny",
      "find * -exec*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",

      // PowerShell / cmd
      "Remove-Item * -Recurse*": "deny",
      "Remove-Item -Recurse*": "deny",
      "rd /s*": "deny",
      "del /s*": "deny",
      "Format-Volume*": "deny",
      "Clear-Disk*": "deny",
      "Stop-Computer*": "deny",
      "Restart-Computer*": "deny",
      "Set-ExecutionPolicy*": "deny",

      // git: history-destroying or outbound. Push yourself.
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "deny",
      "git restore *": "deny",
      "git branch -D*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git filter-branch*": "deny",
      "gh pr merge*": "deny",
      "gh repo delete*": "deny"
    }
  },

  "agent": {
    "build": {
      "temperature": 0.1,
      "top_p": 0.9
    }
  },

  "formatter": true,
  "lsp": true,
  "autoupdate": "notify",
  "share": "disabled",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
