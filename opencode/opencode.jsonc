{
  "$schema": "https://opencode.ai/config.json",

  // ── Cost posture ─────────────────────────────────────────────
  // Four cost classes:
  //
  //   L0 LOCAL         Ollama box on the LAN. Free, unlimited, PRIVATE.
  //                    Weak on capability: 32k-256k context.
  //   L1 FREE          OpenCode Zen free models (big-pickle, nemotron,
  //                    muse, ling) - the whole tier sits on the opencode
  //                    provider. Free, 200k-1M context, tool-capable.
  //   L2 SUBSCRIPTION  Kimi. Flat cost but FINITE QUOTA. The default tier.
  //   L3 METERED       DeepSeek, Google, OpenRouter. Per-token. Analysis +
  //                    validation, and the provider-outage escape hatch.
  //
  // The rule the router follows (agents/orchestrator.md §2):
  //
  //   Quality first. Default to L2 (Kimi). Use L3 for analysis and
  //   validation. Drop to L1 when L2/L3 quota or credit runs out.
  //   Use L0 for privacy, compression and trivia.
  //   Never validate a model's work with the same model.
  //
  // L0 keeps two jobs nothing else should take: work that must not leave
  // the LAN, and session compression, which is high-volume and mechanical.
  // The full escalation ladder is in agents/orchestrator.md.

  // Default when no agent is selected. A free OpenCode Zen model - 200k
  // context, tool-capable, costs nothing, and the opencode provider is
  // already authenticated (see scripts/preflight.cjs).
  "model": "opencode/big-pickle",

  // Title generation / bookkeeping only. Kept local so it never touches quota.
  "small_model": "ollama/qwen2.5-coder:7b",

  // Every request goes through the router.
  // Previously disabled while chasing a hang. Cause identified: subagents
  // were pinned to a model that is not installed (qwen3-coder-next) and to
  // one with no tool-calling capability (deepseek-coder-v2). Both fixed.
  "default_agent": "orchestrator",

  // ── Providers ────────────────────────────────────────────────
  // opencode (Zen), deepseek, moonshotai, kimi-for-coding and anthropic are all
  // first-class in models.dev - they need `opencode auth login`, not a
  // provider block. Only the local box needs describing.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Linux AI Server",
      "options": {
        "baseURL": "http://192.168.86.24:11434/v1",
        "apiKey": "ollama"
      },
      // Verified against http://192.168.86.24:11434/api/tags.
      // Never list a model that is not actually pulled - it surfaces as a
      // hang, not as a clean error.
      "models": {
        "llama3.1:70b": { "name": "Llama 3.1 70B (Local, 131k, tools)" },
        "qwen3:32b": { "name": "Qwen3 32B (Local, 40k, tools+thinking)" },
        "gemma4:26b": { "name": "Gemma 4 26B (Local, 256k, tools+thinking)" },
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B (Local, 32k, NO parsed tool calls)" }
        // Measured by scripts/smoke-agents.cjs: this model answers, but
        // its tool call comes back as JSON *inside content* - ollama does
        // not parse it into `tool_calls`, so no harness can execute it.
        // Fine as small_model (titles); do not route edits here.
        // Deliberately absent:
        //   deepseek-coder-v2  - capabilities ["completion","insert"], no
        //                        tool calling, so it cannot drive an agent.
        //   qwen3-embedding:8b - embedding only.
        //   qwen3-coder-next   - referenced by the old config, never pulled.
      }
    }
  },

  // ── Context maintenance ──────────────────────────────────────
  "compaction": {
    "auto": true,
    "prune": true,        // drop stale tool output before dropping reasoning
    "tail_turns": 8
  },

  // Depth 1: subagents cannot spawn subagents. Deliberate - every hop back
  // through the router preserves context in one place. Letting specialists
  // re-delegate fragments the session across contexts nothing reconciles.
  "subagent_depth": 1,

  // ── Convenience commands ─────────────────────────────────────
  "command": {
    "preflight": {
      "description": "Which providers are authed, what credit is left, which agents are usable",
      "template": "Run: node scripts/preflight.cjs — then summarise which agents are usable, which are DEAD and why, and any provider that is low on credit."
    },
    "ctx": {
      "description": "Measure how many tokens a path set is, and which tiers hold it",
      "template": "Run: node scripts/ctx-estimate.cjs $ARGUMENTS — then state the smallest tier reporting FITS and route accordingly."
    },
    "doc": {
      "description": "Write a technical document - design doc, ADR, runbook, README, spec",
      "agent": "doc-writer",
      "template": "Invoke the `document` skill. $ARGUMENTS"
    },
    "threat-model": {
      "description": "STRIDE threat model / security review of this repo or a design",
      "agent": "security-reviewer",
      "template": "Invoke the `security-review` skill. $ARGUMENTS"
    },
    "design": {
      "description": "Software architecture - boundaries, trade-offs, C4, ADR",
      "agent": "architect",
      "template": "Invoke the `architecture` skill. $ARGUMENTS"
    },
    "cloud": {
      "description": "Cloud architecture - topology, networking, resilience, cost, IaC",
      "agent": "cloud-architect",
      "template": "Invoke the `cloud-architecture` skill. $ARGUMENTS"
    },
    "free": {
      "description": "Force this task onto the free OpenCode Zen tier",
      "agent": "free-coder",
      "template": "$ARGUMENTS"
    },
    "validate": {
      "description": "Cross-model validation of the current diff (never the model that wrote it)",
      "agent": "validator",
      "template": "Validate the uncommitted changes in this repo. Read .opencode/handoff.md first to see which model produced them. Report as path:line - problem - suggested fix, then a one-line verdict: PASS or CHANGES-REQUESTED."
    },
    "local": {
      "description": "Force this task onto the local Ollama box - nothing leaves the LAN",
      "agent": "local-coder",
      "template": "$ARGUMENTS"
    }
  },

  // ── Permissions ──────────────────────────────────────────────
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",

      // Destructive or outbound. Listed FIRST and kept non-overlapping with the
      // read set below, so the outcome never depends on match precedence.
      "sudo *": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "mv *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "find * -delete*": "deny",
      "find * -exec*": "deny",

      // Read-only shell. Each verb appears bare AND with arguments: "ls *"
      // needs a space and an argument, so a plain "ls" would otherwise fall
      // through to "*": ask - that fall-through was the main source of prompts.
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "jq *": "allow",
      "sed -n *": "allow",

      // git, read-only subcommands. Mutating ones are absent, not merely denied.
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git grep *": "allow",
      "git ls-files*": "allow",
      "git rev-parse *": "allow",
      "git describe*": "allow",
      "git shortlog*": "allow",
      "git remote -v": "allow",
      "git cat-file *": "allow",
      "git config --get *": "allow",
      "git stash list": "allow",
      "git worktree list": "allow",
      "git branch": "allow",
      "git branch -a": "allow",
      "git branch -v": "allow",
      "git branch -vv": "allow",
      "git branch --list *": "allow",
      "git branch --merged*": "allow",
      "git tag": "allow"
    }
  },

  "agent": {
    "build": {
      "temperature": 0.1,
      "top_p": 0.9
    }
  },

  "formatter": true,
  "lsp": true,
  "autoupdate": "notify",
  "share": "disabled",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
