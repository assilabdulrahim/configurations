{
  "$schema": "https://opencode.ai/config.json",

  // ── Your models ──────────────────────────────────────────────
  // CHANGED (test): was "ollama/qwen3-coder-next:latest".
  // Pointing at the smallest model that is actually pulled right now,
  // so a failure shows up in seconds instead of minutes.
  // Revert to qwen3-coder-next once the path is proven.
  "model": "ollama/qwen2.5-coder:7b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Linux AI Server",
      "options": {
        "baseURL": "http://192.168.86.24:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        // ADDED: was missing, so it could not be selected in the UI.
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B (Remote)" },
        "qwen3-coder-next:latest": { "name": "Qwen3 Coder Next (Remote)" },
        "deepseek-coder-v2:latest": { "name": "DeepSeek Coder V2 (Remote)" },
        "llama3.1:70b": { "name": "Llama 3.1 70B (Remote)" },
        "gemma4:26b": { "name": "Gemma 4 26B (Remote)" }
      }
    }
  },

  // CHANGED (test): disabled. This is the leading suspect for the hang —
  // an agent that routes/delegates can leave the GPU busy with nothing
  // returning to the client. The previous comment here claimed a missing
  // orchestrator.md degrades to a warning; that claim is unverified.
  // Re-enable this line ONLY after a plain "hi" round-trips successfully.
  // "default_agent": "orchestrator",

  // ── Permissions (write files / run commands) ─────────────────
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "npm run *": "allow",
      "git push *": "ask",
      "npm install *": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny"
    }
  },

  // ── temperature knobs for the default build agent ────────────
  // No prompt file here on purpose. Put project-wide rules in AGENTS.md
  // (auto-loaded) instead of a {file:} reference that can break on a bad path.
  "agent": {
    "build": {
      "temperature": 0.1,
      "top_p": 0.9
    }
  },

  // ── Quality-of-life ──────────────────────────────────────────
  "formatter": true,
  "lsp": true,
  "autoupdate": "notify",
  "share": "disabled",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
